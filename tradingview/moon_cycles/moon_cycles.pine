//@version=6
// Moon node cycles — Rahu / Ketu conjunctions, and what the market did in the
// same lunar slot in earlier months.
//
// From Market Forecast Mastery (Allen Reminick). Not his code.
//
// Three cycles get called "the lunar cycle" and they are different lengths:
//
//   synodic   29.53 d   new moon to new moon. What most people mean.
//   sidereal  27.32 d   the moon once round the zodiac.
//   draconic  27.21 d   north node to north node. The one traded here.
//
// Moon conjunct Rahu (north node) is the moon crossing the ecliptic going
// north; Ketu (south node) is the crossing going south, a fortnight later.
// So no zodiac is needed to find them: they are the two zeros of the moon's
// ecliptic latitude each draconic month, which is arithmetic on the bar's
// timestamp and nothing else.
//
// The point of the table is NOT buy or sell. Measured over the S&P back to
// 1928 and ES since 2000, a Ketu entry wins no more often than any other day
// and Rahu is not bearish — see the README. What the lecture actually asks is
// "what did it do last month, and two months ago, and three?", so that is
// what the table shows, and it marks same or opposite rather than scoring it.

indicator("Moon Node Cycles", shorttitle="Moon", overlay=true,
     max_labels_count=500, max_lines_count=500, max_bars_back=5000)

G_SHOW = "1 · What to mark"
G_BACK = "2 · Earlier months"
G_VIEW = "3 · Display"

showNodes  = input.bool(true,  "Mark moon-Rahu / moon-Ketu conjunctions", group=G_SHOW)
showPhase  = input.bool(false, "Mark new and full moons", group=G_SHOW,
     tooltip="The synodic cycle, 29.53 days — a different cycle from the node one above, and marked separately so the two are never confused.")
showLines  = input.bool(true,  "Vertical line at each node", group=G_SHOW)

monthsBack = input.int(6, "Months to compare", minval=1, maxval=8, group=G_BACK,
     tooltip="\"What did it do last month? And two months ago? They tend to do the opposite each month, and the even numbers back tend to be the same.\"")
showTable  = input.bool(true, "Show the comparison table", group=G_BACK)

rahuCol = input.color(#EF5350, "Rahu", inline="c", group=G_VIEW)
ketuCol = input.color(#26A69A, "Ketu", inline="c", group=G_VIEW)
phaseCol = input.color(#B0BEC5, "Phase", inline="c", group=G_VIEW)

// ── Ephemeris ──
// Meeus, Astronomical Algorithms, ch. 47 and 25. Transcribed term for term
// from cycles/moon.py, which is checked against five published solar
// eclipses: every new moon lands within nine minutes of the catalogued time
// and every eclipse has a node crossing within hours, as it must.

julian(int ms) =>
    ms / 86400000.0 + 2440587.5

// Moon's ecliptic latitude in degrees. Zero at a node.
moonLat(float jd) =>
    float t  = (jd - 2451545.0) / 36525.0
    float D  = math.toradians(297.8501921 + 445267.1114034 * t - 0.0018819 * t * t + t * t * t / 545868.0)
    float M  = math.toradians(357.5291092 + 35999.0502909 * t - 0.0001536 * t * t)
    float Mp = math.toradians(134.9633964 + 477198.8675055 * t + 0.0087414 * t * t + t * t * t / 69699.0)
    float F  = math.toradians(93.2720950 + 483202.0175233 * t - 0.0036539 * t * t - t * t * t / 3526000.0)
    float e  = 1 - 0.002516 * t - 0.0000074 * t * t
    float b = 5128122 * math.sin(F)
         + 280602 * math.sin(Mp + F)
         + 277693 * math.sin(Mp - F)
         + 173237 * math.sin(2 * D - F)
         + 55413 * math.sin(2 * D - Mp + F)
         + 46271 * math.sin(2 * D - Mp - F)
         + 32573 * math.sin(2 * D + F)
         + 17198 * math.sin(2 * Mp + F)
         + 9266 * math.sin(2 * D + Mp - F)
         + 8822 * math.sin(2 * Mp - F)
         + 8216 * e * math.sin(2 * D - M - F)
         + 4324 * math.sin(2 * D - 2 * Mp - F)
         + 4200 * math.sin(2 * D + Mp + F)
         - 3359 * e * math.sin(2 * D + M - F)
         + 2463 * e * math.sin(2 * D - M - Mp + F)
         + 2211 * e * math.sin(2 * D - M + F)
         + 2065 * e * math.sin(2 * D - M - Mp - F)
         - 1870 * e * math.sin(M - Mp - F)
         + 1828 * math.sin(4 * D - Mp - F)
         - 1794 * e * math.sin(M + F)
    b / 1000000.0

// Moon minus sun, folded to (-180, 180]. Zero at new moon, +/-180 at full.
// The longitude series keeps the leading 13 terms of the 16 in moon.py; the
// three dropped ones total under 0.04 degrees, which is under five minutes of
// relative motion and invisible on any bar this runs on. The LATITUDE series
// above is complete, because that is the one the node crossings come from.
elongation(float jd) =>
    float t  = (jd - 2451545.0) / 36525.0
    float D  = math.toradians(297.8501921 + 445267.1114034 * t - 0.0018819 * t * t)
    float M  = math.toradians(357.5291092 + 35999.0502909 * t - 0.0001536 * t * t)
    float Mp = math.toradians(134.9633964 + 477198.8675055 * t + 0.0087414 * t * t)
    float F  = math.toradians(93.2720950 + 483202.0175233 * t - 0.0036539 * t * t)
    float L  = 218.3164477 + 481267.88123421 * t - 0.0015786 * t * t
    float e  = 1 - 0.002516 * t - 0.0000074 * t * t
    float s = 6288774 * math.sin(Mp)
         + 1274027 * math.sin(2 * D - Mp)
         + 658314 * math.sin(2 * D)
         + 213618 * math.sin(2 * Mp)
         - 185116 * e * math.sin(M)
         - 114332 * math.sin(2 * F)
         + 58793 * math.sin(2 * D - 2 * Mp)
         + 57066 * e * math.sin(2 * D - M - Mp)
         + 53322 * math.sin(2 * D + Mp)
         + 45758 * e * math.sin(2 * D - M)
         - 40923 * e * math.sin(M - Mp)
         - 34720 * math.sin(D)
         - 30383 * e * math.sin(M + Mp)
    float moonL = L + s / 1000000.0
    float L0 = 280.46646 + 36000.76983 * t + 0.0003032 * t * t
    float C = (1.914602 - 0.004817 * t - 0.000014 * t * t) * math.sin(M)
         + (0.019993 - 0.000101 * t) * math.sin(2 * M)
         + 0.000289 * math.sin(3 * M)
    float sunL = L0 + C
    ((moonL - sunL) % 360 + 540) % 360 - 180

// ── The timeframe has to be able to hold the cycle ──
//
// A 27.21-day cycle sampled once every 30.44 days does not come out slow, it
// comes out ALIASED: the sign of the latitude read at monthly intervals flips
// on a beat period of 1 / |1/27.21 - 1/30.44| = 257 days, about 8.4 months.
// Run on a monthly chart this script used to mark "Rahu" every eight or nine
// months and fill the table with confident nonsense — measured gaps of 8.1,
// 8.9, 8.0, 8.0, 9.0, 9.0 months against the 8.4 the arithmetic predicts.
//
// Nyquist wants two samples per cycle, so 13.6-day bars is the theoretical
// floor. Weekly clears that and is allowed, though a crossing can then only
// be placed to the week. Anything coarser is refused outright: a wrong answer
// delivered confidently is worse than no answer.
float barDays  = timeframe.in_seconds() / 86400.0
bool  tfUsable = barDays <= 7.5
bool  tfCoarse = barDays > 1.5

jd  = julian(time)
lat = moonLat(jd)
elo = elongation(jd)

// A crossing is a sign change between this bar and the last. Rahu is the one
// going north. On a daily chart that dates the conjunction to the bar it
// falls in, which is all a daily bar can resolve anyway.
crossRahu = tfUsable and not na(lat[1]) and lat[1] < 0 and lat >= 0
crossKetu = tfUsable and not na(lat[1]) and lat[1] > 0 and lat <= 0

// The fold makes elongation jump from +180 to -180 at full moon, so a plain
// sign change finds the full moon as well as the new one. Both tests require
// the values to be small, which is what tells a zero from the cliff.
newMoon  = showPhase and tfUsable and not na(elo[1]) and elo[1] < 0 and elo >= 0 and math.abs(elo) < 90
fullMoon = showPhase and tfUsable and not na(elo[1]) and elo[1] > 0 and elo < 0 and math.abs(elo) > 90

if showNodes and crossRahu
    label.new(bar_index, high, "Rahu", yloc=yloc.abovebar, style=label.style_label_down,
         color=color.new(rahuCol, 20), textcolor=color.white, size=size.tiny)
    if showLines
        line.new(bar_index, low, bar_index, high, xloc=xloc.bar_index, extend=extend.both,
             color=color.new(rahuCol, 70), style=line.style_dotted)

if showNodes and crossKetu
    label.new(bar_index, low, "Ketu", yloc=yloc.belowbar, style=label.style_label_up,
         color=color.new(ketuCol, 20), textcolor=color.white, size=size.tiny)
    if showLines
        line.new(bar_index, low, bar_index, high, xloc=xloc.bar_index, extend=extend.both,
             color=color.new(ketuCol, 70), style=line.style_dotted)

if newMoon
    label.new(bar_index, high, "●", yloc=yloc.abovebar, style=label.style_none,
         textcolor=phaseCol, size=size.small)
if fullMoon
    label.new(bar_index, high, "○", yloc=yloc.abovebar, style=label.style_none,
         textcolor=phaseCol, size=size.small)

// ── What it did in the same slot in earlier months ──
// Each draconic month runs Rahu to Rahu. The newest entry is the month in
// progress, so its return is partial and the table says so.
var array<int> rahuBars = array.new<int>()
if crossRahu
    array.push(rahuBars, bar_index)

var table info = na

if barstate.islast and showTable
    int sz = array.size(rahuBars)
    if na(info)
        info := table.new(position.top_right, 4, monthsBack + 2, border_width=1,
             frame_color=color.new(color.gray, 50), frame_width=1)
    table.cell(info, 0, 0, "Lunar month", bgcolor=color.new(color.black, 20),
         text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, "from", bgcolor=color.new(color.black, 20),
         text_color=color.white, text_size=size.small)
    table.cell(info, 2, 0, "move", bgcolor=color.new(color.black, 20),
         text_color=color.white, text_size=size.small)
    table.cell(info, 3, 0, tfCoarse and tfUsable ? "vs now (bar-resolution only)" : "vs now",
         bgcolor=color.new(color.black, 20), text_color=color.white, text_size=size.small)

    if not tfUsable
        table.cell(info, 0, 1, "timeframe too coarse", text_color=color.red, text_size=size.tiny)
        table.cell(info, 1, 1, str.tostring(barDays, "#.#") + "-day bars",
             text_color=color.red, text_size=size.tiny)
        table.cell(info, 2, 1, "aliases to ~257 d", text_color=color.red, text_size=size.tiny)
        table.cell(info, 3, 1, "use daily, or weekly at a push",
             text_color=color.red, text_size=size.tiny)
    else if sz >= 2
        // Month 0 is Rahu-to-now; month k is the kth completed one back.
        float nowMove = na
        for k = 0 to monthsBack
            int si = sz - 1 - k
            if si >= 0
                int sb = array.get(rahuBars, si)
                int eb = k == 0 ? bar_index : array.get(rahuBars, si + 1)
                int so = bar_index - sb
                int eo = bar_index - eb
                if so >= 0 and so < 5000 and eo >= 0 and eo < 5000 and close[so] != 0
                    float mv = (close[eo] - close[so]) / close[so] * 100.0
                    if k == 0
                        nowMove := mv
                    string same = k == 0 ? "—" :
                         (na(nowMove) ? "?" : ((mv > 0) == (nowMove > 0) ? "same" : "opposite"))
                    // The lecture's rule of thumb, printed as a prediction the
                    // row can be read against rather than as a result.
                    string want = k == 0 ? "" : (k % 2 == 1 ? " (odd: expect opposite)" : " (even: expect same)")
                    table.cell(info, 0, k + 1,
                         k == 0 ? "now, so far" : str.tostring(k) + " back",
                         text_color=color.gray, text_size=size.tiny)
                    table.cell(info, 1, k + 1, str.format_time(time[so], "yyyy-MM-dd"),
                         text_color=color.gray, text_size=size.tiny)
                    table.cell(info, 2, k + 1, str.tostring(mv, "#.##") + "%",
                         text_color=mv > 0 ? ketuCol : rahuCol, text_size=size.tiny)
                    table.cell(info, 3, k + 1, same + want,
                         text_color=color.new(color.white, 20), text_size=size.tiny)
    else
        table.cell(info, 0, 1, "not enough history", text_color=color.gray, text_size=size.tiny)
        table.cell(info, 1, 1, "load more bars", text_color=color.gray, text_size=size.tiny)
